{
  "manifest_version": 3,
  "name": "Synth Workspace Bridge",
  "version": "0.3.0",
  "description": "Lets Synth Workspace drive your own browser and stream BYOK model calls through it, so provider keys never reach a server.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "offscreen", "debugger"],
  "optional_host_permissions": [
    "https://api.anthropic.com/*",
    "https://api.openai.com/*",
    "https://api.deepseek.com/*",
    "https://api.mistral.ai/*",
    "https://api.groq.com/*",
    "https://api.together.xyz/*",
    "https://api.together.ai/*",
    "https://api.fireworks.ai/*",
    "https://api.cerebras.ai/*",
    "https://api.sambanova.ai/*",
    "https://api.studio.nebius.ai/*",
    "https://api.hyperbolic.xyz/*",
    "https://api.perplexity.ai/*",
    "https://api.x.ai/*",
    "https://api.cohere.com/*",
    "https://api.cohere.ai/*",
    "https://api.moonshot.ai/*",
    "https://api.moonshot.cn/*",
    "https://api.minimax.io/*",
    "https://api.minimaxi.com/*",
    "https://api.deepinfra.com/*",
    "https://api.novita.ai/*",
    "https://api.siliconflow.cn/*",
    "https://api.siliconflow.com/*",
    "https://api.ai21.com/*",
    "https://api.llama.com/*",
    "https://api.upstage.ai/*",
    "https://api.voyageai.com/*",
    "https://api.jina.ai/*",
    "https://api.friendli.ai/*",
    "https://api.aimlapi.com/*",
    "https://api.stepfun.com/*",
    "https://api.hunyuan.cloud.tencent.com/*",
    "https://api.lingyiwanwu.com/*",
    "https://api.baichuan-ai.com/*",
    "https://api.302.ai/*",
    "https://api.gmi-serving.com/*",
    "https://api.mancer.tech/*",
    "https://api.lepton.ai/*",
    "https://api.replicate.com/*",
    "https://api.cloudflare.com/*",
    "https://openrouter.ai/*",
    "https://generativelanguage.googleapis.com/*",
    "https://open.bigmodel.cn/*",
    "https://dashscope-intl.aliyuncs.com/*",
    "https://dashscope.aliyuncs.com/*",
    "https://qianfan.baidubce.com/*",
    "https://ark.cn-beijing.volces.com/*",
    "https://router.huggingface.co/*",
    "https://integrate.api.nvidia.com/*",
    "https://models.inference.ai.azure.com/*",
    "https://*.openai.azure.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "externally_connectable": {
    "matches": ["https://suite.synthfit.online/*", "http://localhost/*", "http://127.0.0.1/*"]
  },
  "options_page": "options.html",
  "action": {
    "default_title": "Synth Workspace Bridge",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}

{
  "manifest_version": 3,
  "name": "Synth Workspace Bridge",
  "version": "0.2.0",
  "description": "Lets Synth Workspace drive your own browser and stream BYOK model calls through it, so provider keys never reach a server.",
  "minimum_chrome_version": "116",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "offscreen", "tabs", "debugger"],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "externally_connectable": {
    "matches": ["https://suite.synthfit.online/*", "http://localhost/*", "http://127.0.0.1/*"]
  },
  "options_page": "options.html",
  "action": {
    "default_title": "Synth Workspace Bridge"
  }
}
